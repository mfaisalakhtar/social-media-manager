# ─────────────────────────────────────────────────────────────────────────────
# SOCIAL MEDIA MANAGER — Environment Variables
#
# Supabase project: "Social-app-manager"
#   Account  : akhtarfaisal41@gmail.com  (DEDICATED — NOT the shared ERP account)
#   Project  : owouboeepeogewtylsbl
#   Region   : ap-south-1 (Mumbai)
#   Dashboard: https://supabase.com/dashboard/project/owouboeepeogewtylsbl
#
# Auth: Custom JWT (smm_session cookie) — does NOT use Supabase Auth.
#   Users live in smm_users table (password_hash column, bcrypt).
#   JWT secret: SMM_JWT_SECRET env var.
#
# Vercel project : social-media-manager  (akhtarfaisal41 / Codeink Studio org)
# Live URL       : https://social.codeinkstudio.com
# GitHub repo    : same account, social-media-manager
# ─────────────────────────────────────────────────────────────────────────────

# Supabase — use the Social-app-manager project ONLY (owouboeepeogewtylsbl)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App
APP_BASE_URL=http://localhost:3100

# Custom JWT auth (run: openssl rand -base64 48)
SMM_JWT_SECRET=

# Token encryption for stored OAuth tokens (run: openssl rand -hex 32  — must be 64 hex chars)
TOKEN_ENCRYPTION_KEY=

# Meta (Facebook + Instagram)
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:3100/api/social/facebook/callback

# Instagram direct connect (uses same Meta app — leave blank to auto-fallback to META_APP_ID)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=

# LinkedIn
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:3100/api/social/linkedin/callback

# LinkedIn Pages (same credentials as LinkedIn personal — just a different callback)
LINKEDIN_PAGES_REDIRECT_URI=http://localhost:3100/api/social/linkedin-pages/callback

# X (Twitter)
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://localhost:3100/api/social/x/callback

# Threads
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_REDIRECT_URI=http://localhost:3100/api/social/threads/callback

# Storage (Supabase Storage bucket in the same project, or Cloudflare R2)
STORAGE_ENDPOINT=
STORAGE_BUCKET=smm-media
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# AI (OpenAI or compatible)
OPENAI_API_KEY=

# Development only — use mock platform adapters instead of real social APIs
USE_MOCK_ADAPTERS=true
